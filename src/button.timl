// Button component
// https://getbootstrap.com/docs/5.3/components/buttons/

macro button*(label: string) =
  button.btn: $label

macro link-button*(address: string, label: string) =
  a.btn href=$address: $label

@static for $variant in ["primary", "secondary", "success", "danger", "warning", "info", "light", "dark", "link"]:
  macro button-{$variant}*(label: string) =
    button.btn.btn-{$variant}: $label
  macro button-outline-{$variant}*(label: string) =
    button.btn.btn-outline-{$variant}: $label
  macro link-button-{$variant}*(address: string, label: string) =
    a.btn.btn-{$variant} href=$address: $label
  macro link-button-outline-{$variant}*(address: string, label: string) =
    a.btn.btn-outline-{$variant} href=$address: $label

macro button-lg*(label: string) =
  button.btn.btn-lg: $label

macro button-sm*(label: string) =
  button.btn.btn-sm: $label

macro button-disabled*(label: string) =
  button.btn.disabled disabled: $label

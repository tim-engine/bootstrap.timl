// This module implements Badge Component
// for Tim Engine based on Bootstrap v5.3
// https://getbootstrap.com/docs/5.3/components/badge/

macro badge*(label: string) =
  // Create a new `badge` span
  span.badge: $label

@static for $variant in ["primary", "secondary", "success", "danger", "warning", "info", "light", "dark"]:
  macro badge-{$variant}*(label: string) =
    // Create a badge with bg-{$variant}
    span.badge.bg-{$variant}: $label
  macro badge-pill-{$variant}*(label: string) =
    // Create a rounded-pill badge
    span.badge.rounded-pill.bg-{$variant}: $label

macro badge-pill*(label: string) =
  span.badge.rounded-pill: $label

macro counter-badge*(count: int) =
  // Notification-like badge
  span.badge.position-absolute.top-0.translate-middle.rounded-pill.bg-danger: $count

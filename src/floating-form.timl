// Floating form - kept for backward compat, prefer form.timl
// https://getbootstrap.com/docs/5.3/forms/floating-labels/

macro select-floating*(label: string, placeholder: string, opts: array) =
  div.form-floating
    select.form-select
      option disabled selected: $placeholder
      for $opt in $opts:
        option value=$opt.value: $opt.label
    label: $label

macro floating-input*(label: string, name: string, fieldType: string = "text") =
  div.form-floating
    input.form-control name=$name type=$fieldType placeholder=$label
    label: $label

macro floating-textarea*(label: string, name: string) =
  div.form-floating
    textarea.form-control name=$name placeholder=$label
    label: $label

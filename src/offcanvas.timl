// Offcanvas component
// https://getbootstrap.com/docs/5.3/components/offcanvas/

macro offcanvas*(title: string) =
  div.offcanvas tabindex="-1"
    div.offcanvas-header
      h5.offcanvas-title: $title
      button.btn-close data-bs-dismiss="offcanvas" aria-label="Close" type="button"
    div.offcanvas-body
      @statement


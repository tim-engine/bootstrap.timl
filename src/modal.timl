// Modal component
// https://getbootstrap.com/docs/5.3/components/modal/

macro modal*(title: string) = 
  div.modal tabindex="-1"
    div.modal-dialog > div.modal-content
      div.modal-header
        h5.modal-title: $title
        button.btn-close data-bs-dismiss="modal" aria-label="Close" type="button"
      div.modal-body
        @statement

macro modal-lg*(title: string) =
  div.modal tabindex="-1"
    div.modal-dialog.modal-lg > div.modal-content
      div.modal-header
        h5.modal-title: $title
        button.btn-close data-bs-dismiss="modal" aria-label="Close" type="button"
      div.modal-body
        @statement


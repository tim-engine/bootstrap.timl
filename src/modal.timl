macro fullscreen-modal*(title: string) = 
  div.modal data-bs-keyboard="false" tabindex="-1"
    div.modal-dialog.modal-fullscreen > div.modal-content
      div.modal-header
        h5.modal-title: $title
        button.btn-close data-bs-dismiss="modal" aria-label="Close" type="button"
      div.modal-body
        @statement

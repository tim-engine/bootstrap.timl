// This module implements containers and grid system
// for Tim Engine based on Bootstrap v5.3

macro container*() =
  div.container
    @statement

@static for $size in ["fluid", "xxl", "xl", "lg", "md", "sm"]:
  macro container-{$size}*() =
    div.container-{$size}
      @statement

macro row*() =
  div.row
    @statement

macro col*() =
  div.col
    @statement

macro col-auto*() =
  div.col-auto
    @statement

@static for $x in 1..12:
  macro col-{$x}*() =
    div.col-{$x}
      @statement

  macro col-sm-{$x}*() =
    div.col-sm-{$x}
      @statement

  macro col-md-{$x}*() =
    div.col-md-{$x}
      @statement

  macro col-lg-{$x}*() =
    div.col-lg-{$x}
      @statement

  macro col-xl-{$x}*() =
    div.col-xl-{$x}
      @statement

  macro col-xxl-{$x}*() =
    div.col-xxl-{$x}
      @statement

@static for $bp in ["sm", "md", "lg", "xl", "xxl"]:
  macro col-{$bp}-auto*() =
    div.col-{$bp}-auto
      @statement

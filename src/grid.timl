// This module implements containers and grid system
// for Tim Engine based on Bootstrap v5.3

macro container*() =
  div.container
    @statement

@static for $size in ["fluid", "xxl", "xl", "lg", "md", "sm"]:
  macro container-{$size}*() =
    div.container-{$size}
      @statement

macro row*() =
  div.row
    @statement

macro col*() =
  div.col
    @statement

macro col-auto*() =
  div.col-auto
    @statement

@static for $x in 1..12:
  macro col-{$x}*() =
    div.col-{$x}
      @statement

  macro col-sm-{$x}*() =
    div.col-sm-{$x}
      @statement

  macro col-md-{$x}*() =
    div.col-md-{$x}
      @statement

  macro col-lg-{$x}*() =
    div.col-lg-{$x}
      @statement

  macro col-xl-{$x}*() =
    div.col-xl-{$x}
      @statement

  macro col-xxl-{$x}*() =
    div.col-xxl-{$x}
      @statement

@static for $bp in ["sm", "md", "lg", "xl", "xxl"]:
  macro col-{$bp}-auto*() =
    div.col-{$bp}-auto
      @statement

// Gutters: g-*, gx-*, gy-* (0..5)
// https://getbootstrap.com/docs/5.3/layout/gutters/

@static for $n in 0..5:
  macro row-g-{$n}*() =
    div.row.g-{$n}
      @statement

  macro row-gx-{$n}*() =
    div.row.gx-{$n}
      @statement

  macro row-gy-{$n}*() =
    div.row.gy-{$n}
      @statement

// Offsets: offset-*-* (1..11, all breakpoints)
// https://getbootstrap.com/docs/5.3/layout/columns/#offsetting-columns

@static for $n in 1..11:
  macro col-offset-{$n}*() =
    div.col.offset-{$n}
      @statement

@static for $bp in ["sm", "md", "lg", "xl", "xxl"]:
  @static for $n in 1..11:
    macro col-offset-{$bp}-{$n}*() =
      div.col.offset-{$bp}-{$n}
        @statement

// Order: order-* (0..5, first, last)
// https://getbootstrap.com/docs/5.3/layout/columns/#order-classes

@static for $n in 0..5:
  macro order-{$n}*() =
    div.order-{$n}
      @statement

macro order-first*() =
  div.order-first
    @statement

macro order-last*() =
  div.order-last
    @statement
